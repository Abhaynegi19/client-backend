PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/client-manager

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Days from registration used for the automatic due date
DEFAULT_DUE_DAYS=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Your Company <you@gmail.com>"
SENDER_NAME=Your Company
